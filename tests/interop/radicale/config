[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /tmp/data/users
htpasswd_encryption = plain

[storage]
type = multifilesystem
filesystem_folder = /tmp/data/collections

[rights]
type = from_file
file = /tmp/rights

[web]
type = none

[logging]
level = warning
mask_passwords = true

[headers]
access_control_allow_origin = *
